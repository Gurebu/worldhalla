<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Reads the compiler's output in obj, so the build output it replaces is never merged twice -->
    <Target Name="ILRepacker" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <InputAssemblies Include="@(IntermediateAssembly->'%(FullPath)')" />
            <InputAssemblies Include="@(ReferencePath)" Condition="'%(Filename)' == 'DotnetNoise'" />
            <LibraryPaths Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
        </ItemGroup>

        <ILRepack
            InputAssemblies="@(InputAssemblies)"
            TargetKind="Dll"
            OutputFile="$(TargetPath)"
            LibraryPath="@(LibraryPaths)" />
    </Target>
</Project>
