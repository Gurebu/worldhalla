<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(MSBuildThisFileDirectory)../BuildTools/ValheimLibs.targets" />
    
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>Worldhalla.Plugin</AssemblyName>
        <Description>Custom world generation framework for Valheim</Description>
        <Version>0.1.0</Version>
        <LangVersion>12.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- System.Net.Http version conflict between reference assemblies -->
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" PrivateAssets="all" GeneratePathProperty="true"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.0.0"/>
        <PackageReference Include="HarmonyX" Version="2.7.0" PrivateAssets="all" GeneratePathProperty="true"/>
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.75" IncludeAssets="compile" PrivateAssets="all" GeneratePathProperty="true"/>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="$(ValheimDataPath)/Managed/Unity.TextMeshPro.dll" Private="false" />
        <Reference Include="$(ValheimDataPath)/Managed/assembly_guiutils.dll" Private="false" />
        <Reference Include="$(ValheimDataPath)/Managed/UnityEngine.UI.dll" Private="false" />
        <Reference Include="$(ValheimDataPath)/Managed/gui_framework.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Worldhalla.API\Worldhalla.API.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization/**/*.csv" LogicalName="Localization/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <PropertyGroup>
        <ThunderstoreTeam>Gurebu</ThunderstoreTeam>
        <ThunderstoreName>Worldhalla</ThunderstoreName>
        <ThunderstoreDescription>A framework for custom world generation in Valheim.</ThunderstoreDescription>
        <ThunderstoreIcon>thunderstore/icon.png</ThunderstoreIcon>
        <ThunderstoreReadme>README.md</ThunderstoreReadme>
        <ThunderstoreChangelog>CHANGELOG.md</ThunderstoreChangelog>
    </PropertyGroup>

    <ItemGroup>
        <ThunderstoreDependency Include="denikson-BepInExPack_Valheim" Version="5.4.2202" />
        <ThunderstoreFile Include="$(TargetDir)merged/Worldhalla.dll" PackagePath="BepInEx/plugins/Worldhalla/" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)../BuildTools/Thunderstore.targets" />

</Project>
