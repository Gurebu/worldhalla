<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Target Name="Thunderstore" AfterTargets="Publish">
        <PropertyGroup>
            <ThunderstoreDir>$(ProjectDir)thunderstore/</ThunderstoreDir>
            <ThunderstoreStaging>$(TargetDir)thunderstore/</ThunderstoreStaging>
            <ThunderstorePackage>$(TargetDir)worldhalla-thunderstore-$(Configuration.ToLower())-$(Version).zip</ThunderstorePackage>
        </PropertyGroup>

        <Error Condition="!Exists('$(ThunderstoreDir)icon.png')"
               Text="Thunderstore requires a 256x256 icon at $(ThunderstoreDir)icon.png" />

        <ItemGroup>
            <ThunderstoreFiles Include="$(ThunderstoreDir)manifest.json" />
            <ThunderstoreFiles Include="$(ThunderstoreDir)icon.png" />
            <ThunderstoreFiles Include="$(ThunderstoreDir)README.md" />
        </ItemGroup>
        
        <ItemGroup>
            <PluginFiles Include="$(TargetDir)merged/Worldhalla.dll" />
        </ItemGroup>

        <RemoveDir Directories="$(ThunderstoreStaging)" />
        <Copy SourceFiles="@(ThunderstoreFiles)" DestinationFolder="$(ThunderstoreStaging)" />
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(ThunderstoreStaging)BepInEx/plugins/Worldhalla" />

        <UpdateVersion Filename="$(ThunderstoreStaging)manifest.json" MatchExpression="\%VERSION\%" VersionText="$(Version)" />

        <ZipDirectory Overwrite="true" SourceDirectory="$(ThunderstoreStaging)" DestinationFile="$(ThunderstorePackage)" />
        <RemoveDir Directories="$(ThunderstoreStaging)" />

        <Message Importance="high" Text="Thunderstore package: $(ThunderstorePackage)" />
    </Target>

    <UsingTask
        TaskName="UpdateVersion"
        TaskFactory="RoslynCodeTaskFactory"
        AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Filename ParameterType="System.String" Required="true" />
            <MatchExpression ParameterType="System.String" Required="true" />
            <VersionText ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System"/>
            <Using Namespace="System.IO"/>
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
          File.WriteAllText(
            Filename,
            Regex.Replace(File.ReadAllText(Filename), MatchExpression, VersionText));
        ]]>
            </Code>
        </Task>
    </UsingTask>
</Project>
