<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>Worldhalla</AssemblyName>
        <LangVersion>12.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
            Makes the compiler mark the assembly with SkipVerification, which is what lets Mono ignore access
            checks on the plugin's publicized game members. ILRepack keeps only this assembly's permission set
            when it merges the plugin in, so the mark has to be here, not just on the plugin.
        -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
    </ItemGroup>

</Project>
