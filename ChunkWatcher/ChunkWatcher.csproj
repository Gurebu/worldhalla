<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(MSBuildThisFileDirectory)../BuildTools/ValheimLibs.targets" />
    
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>ChunkWatcher</AssemblyName>
        <Description>Simple Bepinex mod to profile</Description>
        <Version>1.0.0</Version>
        <LangVersion>latest</LangVersion>

        <!-- System.Net.Http version conflict between reference assemblies -->
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" GeneratePathProperty="true" />
        <PackageReference Include="BepInEx.Core" Version="5.4.21" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.0.0" />
        <PackageReference Include="HarmonyX" Version="2.7.0" GeneratePathProperty="true" />
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.75" IncludeAssets="compile" GeneratePathProperty="true" />
    </ItemGroup>
</Project>
